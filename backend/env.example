DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.your_project_ref
DB_PASSWORD=your_supabase_password_here
PORT=3000
ENGINE_URL=http://127.0.0.1:5001
BATCH_INTERVAL_MS=60000

JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Email delivery -- Brevo (switched from Resend; see emailService.js comment
# for why). Free tier: 300 emails/day, sends to ANY recipient once your
# sender email is verified in Brevo's dashboard (no domain purchase needed).
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
FROM_EMAIL=your_verified_sender@example.com
FROM_NAME=RoktoNet

# Frontend origin -- used for CORS and for building verify/reset-password
# links inside emails (they point at frontend pages, not the raw API).
FRONTEND_URL=http://localhost:5173

# Set to "production" only on your deployed backend (e.g. Render). Flips
# cookie settings (secure + sameSite) to what cross-origin HTTPS needs.
NODE_ENV=
