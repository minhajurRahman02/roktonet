DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.your_project_ref
DB_PASSWORD=your_supabase_password_here
PORT=3000
ENGINE_URL=http://127.0.0.1:5001
BATCH_INTERVAL_MS=60000

# Auth (Phase 7.1) -- JWT_SECRET signs every session token.
# Generate a strong random one, never reuse the example value, never commit the real .env.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Email delivery (Phase 7.2) -- Resend
RESEND_API_KEY=re_your_resend_api_key_here
# Sandbox address, works with zero setup but can only send TO the email
# that owns your Resend account. Switch to noreply@yourdomain.com once
# you verify a real domain in Resend's dashboard -- no code change needed.
FROM_EMAIL=RoktoNet <onboarding@resend.dev>

# Frontend origin (Phase 7.3) -- used for two things: (1) CORS, so the
# backend only accepts credentialed requests from this exact origin, and
# (2) building the verify/reset-password links inside emails, since those
# now point at frontend pages rather than the raw backend API.
FRONTEND_URL=http://localhost:5173

# Set to "production" only on your deployed backend (e.g. Render). This
# flips cookie settings (secure + sameSite) to what cross-origin HTTPS
# needs. Leave unset/blank for local development.
NODE_ENV=
