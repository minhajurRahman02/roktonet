# Leave BLANK for local development -- requests go to '/api/...' and Vite's
# dev-server proxy (vite.config.js) forwards them to your local backend.
#
# Set this ONLY when building for production deployment (Phase 7.9), to
# your deployed backend's real URL, e.g.:
# VITE_API_URL=https://roktonet-backend.onrender.com
VITE_API_URL=

# The optimization engine's deployed URL, used ONLY for the wake-up ping
# in api/engine.js (Render's free tier sleeps idle services after 15 min).
# Leave BLANK for local development -- nothing sleeps locally, and a blank
# value makes warmEngine() a no-op by design. Example:
# VITE_ENGINE_URL=https://roktonet-engine.onrender.com
VITE_ENGINE_URL=

# Roktim's forecast service (Phase 6E). The browser calls this DIRECTLY --
# the Node backend is not in the advisory path at all -- so unlike the engine
# this URL is used for real requests, not just a wake-up ping.
#
# Leave BLANK and Roktim is simply absent: every surface renders nothing and
# the app behaves exactly as it did before the module existed.
#
# THIS FILE (.env) IS LOADED IN BOTH MODES -- `npm run dev` and `npm run build`.
# frontend/.env.production is loaded ONLY by `npm run build`, which is why the
# committed production value there does not help the dev server. If Roktim
# works in one and not the other, that asymmetry is the first thing to check,
# and `node check-roktim.mjs` prints exactly what each mode resolves.
#
# Set it to the deployed service, or to your local one on port 5002 if you are
# working on Roktim itself. Example:
# VITE_ROKTIM_URL=https://roktonet-forecast.onrender.com
VITE_ROKTIM_URL=
